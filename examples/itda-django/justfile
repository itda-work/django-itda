# itda-django — 단계별 실행세계

# 명령 목록
default:
    @just --list

# 의존성 설치 → 마이그레이션 → 세계 심기
setup:
    uv sync
    uv run python manage.py migrate
    uv run python manage.py seed_world

# 개발 서버
run:
    uv run python manage.py runserver

# 테스트 — NN 을 주면 그 단계만, 없으면 전체
test NN='':
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "{{ NN }}" ]; then
        uv run pytest
    else
        uv run pytest tests/stage_{{ NN }}_*.py
    fi

# 장부를 본다 — 세계가 움직인 사실이 어떻게 남았나 (7단계)
ledger *ARGS:
    uv run python manage.py ledger {{ ARGS }}

# 단계 시작 상태로 이동
stage NN:
    git checkout stage-{{ NN }}-start

# 경합을 눈으로 본다 — 같은 요청 두 개를 동시에 쏜다 (refund / pay / approve)
race MODE TARGET *ARGS:
    uv run python manage.py race {{ MODE }} {{ TARGET }} {{ ARGS }}

# 공유 세계 — 옆자리 학생이 내 세계에 요청을 보낼 수 있게 문을 연다 (5단계)
run-shared:
    WORLD_SHARED=1 uv run python manage.py runserver 0.0.0.0:8000

# 실접속 트랙 — API 토큰 발급 (원문 키는 여기서 한 번만 나온다)
token USERNAME='ai-staff' NAME='claude-code':
    uv run python manage.py issue_token {{ USERNAME }} --name {{ NAME }}

# 실접속 트랙 — MCP 서버(stdio). 별도 프로세스다. just run 이 떠 있어야 한다
mcp:
    uv run python agent/live/mcp_server.py

# 실접속 트랙 — 패키지 경로의 MCP 서버(stdio). Django 프로세스 안이라 just run 이 필요 없다
mcp-pkg:
    uv run python manage.py mcp_stdio

# DB 를 지우고 세계를 처음부터 다시 심는다
reset-db:
    rm -f db.sqlite3
    uv run python manage.py migrate
    uv run python manage.py seed_world

# 실접속 트랙 — 세계를 새로 심고 열쇠까지 새로 건다 (reset-db → 토큰 발급 → MCP 재등록 → 확인)
live-setup: reset-db
    #!/usr/bin/env bash
    set -euo pipefail
    "{{ justfile_directory() }}/scripts/live_register.sh"

# 실접속 트랙 — 세계는 두고 열쇠만 새로 건다 (토큰 발급 → MCP 재등록 → 확인)
live-register:
    #!/usr/bin/env bash
    set -euo pipefail
    "{{ justfile_directory() }}/scripts/live_register.sh"

# Postgres 실측 — 임시 컨테이너(itda-django-pg, 127.0.0.1:55433)를 띄우고 준비될 때까지 기다린다
pg-up:
    #!/usr/bin/env bash
    set -euo pipefail
    if docker inspect itda-django-pg >/dev/null 2>&1; then
      docker start itda-django-pg >/dev/null
    else
      docker run -d --name itda-django-pg \
        -e POSTGRES_PASSWORD=itda -e POSTGRES_USER=itda -e POSTGRES_DB=itda \
        -p 127.0.0.1:55433:5432 postgres:17-alpine >/dev/null
    fi
    for _ in $(seq 1 60); do
      if docker exec itda-django-pg pg_isready -U itda -d itda >/dev/null 2>&1; then
        echo 'itda-django-pg 준비 완료 (127.0.0.1:55433)'; exit 0
      fi
      sleep 1
    done
    echo 'itda-django-pg 가 60초 안에 준비되지 않았다' >&2; exit 1

# Postgres 실측 컨테이너를 지운다
pg-down:
    docker rm -f itda-django-pg

# 테스트를 Postgres 로 — 예: just test-pg tests/stage_05_*.py
test-pg *ARGS:
    DJANGO_SETTINGS_MODULE=pg_settings PYTHONPATH=probes uv run --with 'psycopg[binary]' pytest {{ ARGS }}

# Postgres 에 마이그레이션 — ledger/0002 트리거 같은 백엔드 의존을 실측한다
migrate-pg:
    DJANGO_SETTINGS_MODULE=pg_settings PYTHONPATH=probes uv run --with 'psycopg[binary]' python manage.py migrate --noinput
